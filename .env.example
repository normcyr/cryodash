# CryoDash Environment Configuration

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database configuration
# Local: sqlite:///./cryodash_data/cryodash.db
# Docker: sqlite:////app/data/cryodash.db
DATABASE_URL=sqlite:///./cryodash_data/cryodash.db
DB_ECHO=False

# Security configuration
# Enable/disable API key authentication (default: true in production)
REQUIRE_API_KEY=false

# API key for securing POST endpoints (/api/readings, /api/instruments, /api/sync-logs)
# IMPORTANT: Change this to a secure random string in production!
# In production on Render, use environment group for secure storage
API_KEY=change-me-in-production-generate-secure-random-key
